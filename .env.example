# Intuit QuickBooks Online app credentials.
# Get these from https://developer.intuit.com -> your app -> Keys & OAuth.
# Use the Sandbox Client ID/Secret when QUICKBOOKS_ENVIRONMENT=sandbox, and
# the Production Client ID/Secret when QUICKBOOKS_ENVIRONMENT=production —
# Intuit issues separate keys per environment; do not mix them.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# Must exactly match a Redirect URI registered in the Intuit app, under the
# same environment's section (Sandbox or Production) as QUICKBOOKS_ENVIRONMENT
# below. For local dev this is the localhost URL; when deployed, change this
# to your deployment's HTTPS URL and register that same URL in the Intuit app.
INTUIT_REDIRECT_URI=http://localhost:8000/callback

# "sandbox" or "production" — no other value is accepted, the app refuses to
# start otherwise. WARNING: "production" connects to a real QuickBooks company
# and all writes (e.g. Bill creation) are real financial transactions.
QUICKBOOKS_ENVIRONMENT=sandbox

# Flask session/flash signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# QuickBooks Online REST API base URL. Use the sandbox host while
# QUICKBOOKS_ENVIRONMENT=sandbox, and https://quickbooks.api.intuit.com/v3
# once QUICKBOOKS_ENVIRONMENT=production.
QUICKBOOKS_BASE_URL=https://sandbox-quickbooks.api.intuit.com/v3

# Local dev port for `python app.py`. Cloud Run overrides this itself.
PORT=8000

# Upstash Redis (REST API) — stores the OAuth token so it survives across
# serverless invocations. Create a free database at https://upstash.com,
# then copy its REST URL and token from the database's dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Target Google Sheet for the daily invoice sync (see DEPLOY.md).
# GOOGLE_SHEET_ID is the id segment in the sheet's URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# GOOGLE_SHEET_NAME is the tab name the rows are written to.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Invoices

# Full contents of a GCP service account key JSON, as a single line, with
# write access to the sheet above (see DEPLOY.md for how to create it).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Vercel Cron Jobs automatically send this value as `Authorization: Bearer
# <CRON_SECRET>` on every cron-triggered request — set the same env var name
# here so app.py can verify the call actually came from Vercel Cron.
# Required — /sync-invoices rejects every request when this is unset, since
# the endpoint is publicly reachable on Vercel with no platform-level auth in
# front of it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
